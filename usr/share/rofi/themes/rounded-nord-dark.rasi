/* ROUNDED THEME FOR ROFI - LAIN EDITION */
/* Adapted from Newman Sanchez's template */

* {
    /* Deep dark blue-black background (with transparency) */
    bg0:    #080F16E6; 
    
    /* Slightly lighter dark blue for element backgrounds */
    bg1:    #0F1B26;   
    
    /* Selection hover color (translucent dark blue) */
    bg2:    #1A2D3E80; 
    
    /* Bright terminal blue for active/accent text and elements */
    bg3:    #7CC2DFE6; 
    
    /* Main text color (crisp, light blue-gray) */
    fg0:    #D5E3EC;   
    
    /* Highlighted text color */
    fg1:    #FFFFFF;   
    
    /* Muted text color */
    fg2:    #829AA7;   
    
    /* Darker accent for borders or inactive states */
    fg3:    #243B4E;   
}

@import "template/rounded-template.rasi"

element selected {
    /* Sets the text color of the selected item to match the deep background */
    text-color: @bg1; 
}
